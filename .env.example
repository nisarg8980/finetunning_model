# Copy this file to ".env" and paste your real tokens in.
#   Windows:  copy .env.example .env
# The .env file is git-ignored so your tokens never get committed.

# Hugging Face tokens — create at https://huggingface.co/settings/tokens

# READ token: enough to download gated Mistral weights and to train / evaluate.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WRITE token: needed ONLY to push a model to the Hub (push_to_hub.py / --push_repo).
# Create it with "Write" access. If you never push, you can leave this as-is.
HF_WRITE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
