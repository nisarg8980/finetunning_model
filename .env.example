# Copy this file to ".env" and paste your real token in.
#   Windows:  copy .env.example .env
# The .env file is git-ignored so your token never gets committed.

# Hugging Face access token — get one at https://huggingface.co/settings/tokens
# A "Read" token is enough to train. Use a "Write" token only if you push to the Hub.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
